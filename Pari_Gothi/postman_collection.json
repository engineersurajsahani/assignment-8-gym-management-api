    {
      "name": "2. Fitness Classes & Booking",
      "item": [
        {
          "name": "Create Fitness Class (Capacity: 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"HIIT Bootcamp\",\n  \"trainerName\": \"John Doe\",\n  \"scheduleDate\": \"2026-05-01T10:00:00.000Z\",\n  \"durationMinutes\": 60,\n  \"maxCapacity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Get All Classes (Filter by Trainer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?trainer=John",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"],
              "query": [
                {
                  "key": "trainer",
                  "value": "John"
                }
              ]
            }
          }
        },
        {
          "name": "Get Class Details By ID (Populated Enrolled Members)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          }
        },
        {
          "name": "Book Class - Member 1 (Success)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}", "book"]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}", "cancel"]
            }
          }
        }
      ]
    },
